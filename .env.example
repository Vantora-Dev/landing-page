# Copy to .env.local for development, and set these in the Vercel project.

# Canonical origin. Feeds metadata, canonical URL, sitemap and JSON-LD.
# No trailing slash (one is stripped automatically if you add it anyway).
NEXT_PUBLIC_SITE_URL=https://laundrogrid.com

# --- REQUIRED for bookings to reach the inbox ------------------------------
# Bookings are emailed to hello@laundrogrid.com through Resend
# (https://resend.com), and the visitor is emailed a confirmation with a
# calendar file. Create an API key there and verify the laundrogrid.com
# domain so mail can be sent from it — that adds DKIM/SPF records on a
# subdomain and leaves the Google Workspace MX records alone.
#
# Without a working sink (this, the calendar, or the webhook below) the form REFUSES the
# booking and tells the visitor to phone instead, rather than pretending it
# was received. Bookings are never silently dropped, but they are also not
# captured until this is set.
RESEND_API_KEY=

# Sender for those emails. Must be on the domain verified in Resend.
# Defaults to "LaundroGrid Bookings <bookings@laundrogrid.com>".
BOOKING_EMAIL_FROM=

# --- Google Calendar: stops two people booking the same slot ---------------
# Bookings are added to this calendar, and anything already on it (bookings or
# your own meetings) is removed from the times the form offers. Setup is in
# the README under "Connecting Google Calendar". Leave these empty and every
# slot is offered; bookings still arrive by email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the service account's JSON key file, pasted
# whole, including the BEGIN/END lines. Literal \n sequences are fine.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Calendar to use. Defaults to hello@laundrogrid.com (that account's main
# calendar). It must be shared with the service account.
GOOGLE_CALENDAR_ID=

# Optional second copy of every booking: a Slack incoming webhook, a Discord
# webhook, a Zapier/Make catch hook, or your own endpoint. One payload shape
# serves all of them — Slack reads `text`, Discord reads `content`, everything
# else reads `lead`.
LEAD_WEBHOOK_URL=

# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX". Leave empty and no
# analytics script is loaded. Read at build time, so redeploy after changing.
NEXT_PUBLIC_GA_ID=
