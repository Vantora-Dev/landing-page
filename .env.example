# Copy to .env.local for development, and set these in the Vercel project.

# Canonical origin. Feeds metadata, canonical URL, sitemap and JSON-LD.
# No trailing slash (one is stripped automatically if you add it anyway).
NEXT_PUBLIC_SITE_URL=https://laundrogrid.com

# --- REQUIRED for the contact form to capture anything ---------------------
# Where a submitted enquiry is delivered. Accepts any endpoint that takes a
# POST: a Slack incoming webhook, a Discord webhook, a Zapier/Make catch hook,
# or your own endpoint. One payload shape serves all of them — Slack reads
# `text`, Discord reads `content`, everything else reads `lead`.
#
# Without this the form REFUSES the submission and tells the visitor to phone
# instead, rather than pretending the details were received. Leads are never
# silently dropped, but they are also not captured until this is set.
LEAD_WEBHOOK_URL=

# Cal.com booking handle, e.g. "laundrogrid/15min" (NOT the full URL).
# Leave empty and the calendar simply doesn't render — the phone number and
# the contact form carry the section on their own.
NEXT_PUBLIC_CAL_LINK=
