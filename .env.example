# Copy to .env.local for development, and set both in the Vercel project.

# Canonical origin. Used for metadata, canonical URL, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://laundrogrid.com

# Cal.com booking handle, e.g. "laundrogrid/15min".
# Leave empty and the booking section renders a clearly marked placeholder
# instead of a broken embed. The contact form works either way.
NEXT_PUBLIC_CAL_LINK=
